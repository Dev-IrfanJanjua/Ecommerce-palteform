# Copy to .env and adjust. .env is gitignored — never commit real values.

NODE_ENV=development
PORT=5000

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# Rate limiting, per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# MongoDB. Required in production; optional in development so the API boots
# before Atlas is configured.
# Atlas format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=qadam

# JWT secrets — MUST be different from each other, 32+ chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
