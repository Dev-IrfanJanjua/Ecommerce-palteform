{
  "name": "backend",
  "version": "1.0.0",
  "description": "E-commerce REST API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "smoke": "NODE_ENV=test tsx scripts/smoke-test.mts",
    "seed": "tsx scripts/seed.mts",
    "db:check": "tsx scripts/check-models.mts",
    "api:test": "NODE_ENV=test tsx scripts/api-test.mts",
    "auth:test": "NODE_ENV=test AUTH_RATE_LIMIT_MAX=500 tsx scripts/auth-test.mts",
    "db:ping": "tsx scripts/db-ping.mts",
    "cart:test": "NODE_ENV=test AUTH_RATE_LIMIT_MAX=500 tsx scripts/cart-test.mts",
    "order:test": "NODE_ENV=test AUTH_RATE_LIMIT_MAX=500 tsx scripts/order-test.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "pino-pretty": "^13.2.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
