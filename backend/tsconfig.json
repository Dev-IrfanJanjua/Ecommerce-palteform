{
  "compilerOptions": {
    // TypeScript 7 removed moduleResolution "node10" and "baseUrl". With the
    // package left as CommonJS, "nodenext" resolves extensionless relative
    // imports the way Node does for CJS.
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,

    // The seed and model-check scripts import the frontend's catalogue
    // generator so the two never drift. That file uses its own "@/" alias, so
    // the backend's is given a fallback: resolve against backend/src first,
    // then frontend/src. Only scripts/ reaches across; src/ never does, and
    // scripts/ is excluded from the compiled build.
    "paths": { "@/*": ["./src/*", "../frontend/src/*"] }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
