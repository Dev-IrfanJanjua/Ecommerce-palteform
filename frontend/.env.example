# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
#
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Anything secret must NOT use that prefix.

# Base URL of the backend REST API.
# Unused in Phase 1 (the storefront runs on the local mock catalog).
# Set this once the Express backend exists.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Public site URL, used for absolute URLs in metadata and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
