{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack e-commerce platform - repository root. Application code lives in frontend/ and later backend/.",
  "scripts": {
    "prepare": "husky",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run validate:catalog && npm run build && npm run backend:typecheck && npm run backend:build && npm run backend:smoke && npm run backend:db-check",
    "validate:catalog": "npm --prefix frontend run validate:catalog",
    "backend": "npm --prefix backend run",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:smoke": "npm --prefix backend run smoke",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:seed": "npm --prefix backend run seed",
    "backend:db-check": "npm --prefix backend run db:check",
    "backend:ping": "npm --prefix backend run db:ping"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
